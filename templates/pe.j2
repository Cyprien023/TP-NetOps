! === PE ROUTER ===
ip routing

interface Loopback0
   ip address {{ loopback }}/32

! Backbone
interface {{ backbone_iface }}
   no switchport
   ip address {{ backbone_ip }}/30
   ip ospf area 0.0.0.0

router ospf {{ ospf_pid }}
   router-id {{ loopback }}
   passive-interface Loopback0

mpls ip

mpls ldp
   router-id {{ loopback }}
   interface {{ backbone_iface }}

! VRF
{% for vrf in vrfs %}
vrf instance {{ vrf.name }}
   rd {{ vrf.rd }}

ip routing vrf {{ vrf.name }}

interface {{ vrf.ce_iface }}
   no switchport
   vrf {{ vrf.name }}
   ip address {{ vrf.pe_ip }}/30

{% endfor %}

! BGP
router bgp {{ bgp_as }}
   router-id {{ loopback }}
   neighbor {{ rr_loopback }} remote-as {{ bgp_as }}
   neighbor {{ rr_loopback }} update-source Loopback0
   neighbor {{ rr_loopback }} send-community extended
   address-family vpn-ipv4
      neighbor {{ rr_loopback }} activate

{% for vrf in vrfs %}
   vrf {{ vrf.name }}
      rd {{ vrf.rd }}
      route-target import vpn-ipv4 {{ vrf.rt }}
      route-target export vpn-ipv4 {{ vrf.rt }}
      neighbor {{ vrf.ce_ip }} remote-as {{ vrf.ce_as }}
      address-family ipv4
         neighbor {{ vrf.ce_ip }} activate

{% endfor %}